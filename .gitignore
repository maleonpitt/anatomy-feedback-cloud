*.pid
*.log

# Certificates, keys, and secrets
pem/
*.pem

# MacOS / system
.DS_Store

# Local builds and deploy artifacts
frontend/build/
*.tar.gz

# Terraform local cache (lock file is committed)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*

# Legacy nginx logs (if recreated at repo root only)
/nginx/

# Runtime session / category data
flask_session/
sessions/
backend/sessions/
backend/categories.csv
backend/data.csv
