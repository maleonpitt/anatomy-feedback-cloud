node_modules/
frontend/node_modules/
backend/node_modules/

# Python cache
__pycache__/
*.pyc

# Virtual environments / test tooling
venv/
.venv/
.venv-pytest/
.pytest_cache/

# Environment files with secrets (allow committed examples only)
.env
.env.*
!.env.example
!**/.env.example

