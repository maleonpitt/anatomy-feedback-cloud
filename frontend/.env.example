# =============================================================================
# Frontend environment (Create React App) — public / safe for browser bundle
# =============================================================================
# CRA only exposes variables prefixed with REACT_APP_ to client code.
#
# Local development (see docs/LOCAL_DEVELOPMENT.md):
#   UI:  http://localhost:3000  (npm start)
#   API: http://localhost:5001  (uvicorn main:app or docker-compose up backend)
#
# Hypothetical deployed (document only — not configured in this repo):
#   REACT_APP_API_BASE_URL=https://api.example.com
#   UI served from https://app.example.com via CloudFront → private S3
#
# API paths are explicit (no /api prefix). FastAPI routes match directly:
#   GET  /get-session-email
#   POST /upload-categories
#   etc.
#
# Temporary local auth bypass (Option B) — skip Microsoft Login UI:
#   REACT_APP_SKIP_AUTH=true
# Backend must also have FLASK_ENV=local and SKIP_AUTH=true.
# Reverse: set false / remove, restart npm, restart uvicorn.
#
# Copy: cp .env.example .env
# =============================================================================

REACT_APP_API_BASE_URL=http://localhost:5001
# REACT_APP_SKIP_AUTH=true
