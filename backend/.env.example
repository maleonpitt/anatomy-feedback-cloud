# =============================================================================
# Backend environment (FastAPI / Uvicorn runtime)
# =============================================================================
# Copy to .env for local development:
#   cp .env.example .env
#
# AWS authentication: prefer an EC2/ECS instance or task IAM role in production.
# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in frontend env files.
# =============================================================================

# --- Required (local + production) ---
FLASK_ENV=local
SESSION_SECRET_KEY=replace-with-long-random-string

# Temporary local auth bypass (Option B). Requires FLASK_ENV=local.
# Enables GET /dev-login for the UI without Microsoft OAuth.
# Default OFF for public clones. Enable only on your machine when needed.
# Reverse: SKIP_AUTH=false (or remove) and restart uvicorn.
# SKIP_AUTH=true
# DEV_LOGIN_EMAIL=local-dev@example.com

# Frontend origin (CORS + OAuth redirect target)
# Dual-origin local simulation: http://localhost:3000 (CRA) + API on :5001
FRONTEND_URL=http://localhost:3000
# Optional extra CORS origins (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:8080

MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=your-azure-tenant-id
# OAuth callback must be on the API host (local API port shown)
MICROSOFT_REDIRECT_URI=http://localhost:5001/callback

OPENAI_API_KEY=sk-replace-me

# --- Category storage (Phase 4) ---
CATEGORY_STORE_TYPE=local
# CATEGORY_STORE_TYPE=s3
# CATEGORY_BUCKET_NAME=your-feedback-categories-bucket
# AWS_REGION=us-east-1

# --- Session cookie overrides (optional; see docs/DUAL_ORIGIN.md) ---
# Local defaults: Secure=false, SameSite=lax, host-only cookie on API
# Hypothetical HTTPS dual-origin (api.example.com):
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_DOMAIN=          # usually leave unset (host-only on API)

# --- Hypothetical deployed dual-origin (document only) ---
# FLASK_ENV=production
# FRONTEND_URL=https://app.example.com
# MICROSOFT_REDIRECT_URI=https://api.example.com/callback
# CATEGORY_STORE_TYPE=s3
# CATEGORY_BUCKET_NAME=your-production-bucket
# AWS_REGION=us-east-1

# --- Future IAM role permissions (production, CATEGORY_STORE_TYPE=s3) ---
# s3:PutObject, s3:GetObject on arn:aws:s3:::bucket/categories/*
